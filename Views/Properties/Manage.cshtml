@model List<Property>
@{ViewData["Title"]="Manage listings";}<div class="page-intro"><p class="eyebrow">YOUR PROPERTIES</p><h1>Manage listings</h1><p>Inactive listings are hidden from public search.</p></div><p><a class="btn" asp-controller="HostApplications" asp-action="Apply">Add another property</a></p><div class="table-wrap"><table><thead><tr><th>Property</th><th>Price/night</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Title<br/><span class="muted">@p.City</span></td><td>R @p.PricePerNight.ToString("N2")</td><td>@(p.IsActive?"Active":"Inactive")</td><td><form asp-action="ToggleActive" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="btn small">@(p.IsActive?"Deactivate":"Activate")</button></form></td></tr>}</tbody></table></div>
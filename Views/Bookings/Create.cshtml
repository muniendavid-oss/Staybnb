@model BookingCreateViewModel
@{ViewData["Title"]="Reserve your stay";var p=(Property)ViewBag.Property;}<div class="page-intro"><p class="eyebrow">YOUR NEXT STAY</p><h1>Reserve @p.Title</h1><p>@p.City · R @p.PricePerNight.ToString("N2") per night</p></div><form asp-action="Create" method="post" class="panel form-card"><div asp-validation-summary="ModelOnly" class="error"></div><input asp-for="PropertyId" type="hidden"/><label asp-for="CheckIn">Check-in</label><input asp-for="CheckIn" type="date"/><label asp-for="CheckOut">Check-out</label><input asp-for="CheckOut" type="date"/><label asp-for="Travelers">Number of travelers</label><input asp-for="Travelers" type="number" min="1" max="@p.MaxGuests"/><p class="muted">Final price = nightly rate × nights + cleaning fee + service fee. Total is calculated on the server.</p><p>Cleaning fee: R @p.CleaningFee.ToString("N2") · Service fee: R @p.ServiceFee.ToString("N2")</p><button class="btn full">Request booking</button></form>
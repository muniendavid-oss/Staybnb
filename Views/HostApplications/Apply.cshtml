@model HostApplicationViewModel
@{ViewData["Title"]="Become a host";}<div class="page-intro"><p class="eyebrow">OPEN YOUR DOOR</p><h1>Become a Staybnb host</h1><p>Tell guests about your space. Your application must include at least one valid property image.</p></div><form asp-action="Apply" method="post" enctype="multipart/form-data" class="panel form-card wide"><div asp-validation-summary="ModelOnly" class="error"></div><div class="form-grid"><div><label asp-for="Title">Property title</label><input asp-for="Title" placeholder="e.g. Sunlit city apartment"/><span asp-validation-for="Title" class="field-error"></span></div><div><label asp-for="PropertyType">Property type</label><select asp-for="PropertyType"><option>Apartment</option><option>House</option><option>Guesthouse</option><option>Villa</option><option>Cabin</option></select></div><div><label asp-for="City"></label><input asp-for="City"/></div><div><label asp-for="Address"></label><input asp-for="Address"/></div><div><label asp-for="PricePerNight">Price per night (R)</label><input asp-for="PricePerNight" type="number" min="1" step="0.01"/></div><div><label asp-for="MaxGuests">Maximum guests</label><input asp-for="MaxGuests" type="number" min="1" max="30"/></div><div><label asp-for="CleaningFee">Cleaning fee (R)</label><input asp-for="CleaningFee" type="number" min="0" step="0.01"/></div><div><label asp-for="ServiceFee">Service fee (R)</label><input asp-for="ServiceFee" type="number" min="0" step="0.01"/></div></div><label asp-for="Description"></label><textarea asp-for="Description" rows="5" placeholder="Describe the space, amenities, and neighbourhood..."></textarea><label asp-for="Images">Property images (JPG, PNG or WEBP; max 5 MB each)</label><input asp-for="Images" type="file" accept="image/jpeg,image/png,image/webp" multiple/><span asp-validation-for="Images" class="field-error"></span><button class="btn">Submit application</button></form>
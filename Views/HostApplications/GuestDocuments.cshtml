@model List<GuestDocument>
@{ViewData["Title"]="Guest document review";}<div class="page-intro"><h1>Guest document review</h1><p>Review documents uploaded for bookings on your properties. Private document files are not exposed through public URLs.</p></div><div class="table-wrap"><table><thead><tr><th>Booking / Property</th><th>Guest</th><th>Document</th><th>Status</th><th>Review</th></tr></thead><tbody>@foreach(var d in Model){<tr><td>#@d.BookingId · @d.Booking?.Property?.Title</td><td>@d.Booking?.Guest?.Email</td><td>@d.DocumentType · <a asp-action="ViewGuestDocument" asp-route-id="@d.Id" target="_blank" rel="noopener">View document</a> · @d.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td><td>@d.Status</td><td>@if(d.Status=="Pending"){<form asp-action="VerifyGuestDocument" method="post" class="actions"><input type="hidden" name="id" value="@d.Id"/><button class="btn small" name="decision" value="Verified">Verify</button><button class="btn danger small" name="decision" value="Rejected">Reject</button></form>}</td></tr>}</tbody></table></div>@if(Model.Count==0){<div class="empty"><p>No guest documents have been uploaded for your properties.</p></div>}
@model List<HostApplication>
@{ViewData["Title"]="Review applications";}<div class="page-intro"><h1>Host applications</h1><p>Approving swaps the user's role from Guest to Host and activates the submitted property.</p></div><div class="stack">@foreach(var a in Model){<article class="panel application"><div><h2>@a.Property?.Title</h2><p class="muted">Applicant: @a.Applicant?.DisplayName · @a.Applicant?.Email</p><p>@a.Property?.City · @a.Property?.Address</p><p>R @a.Property?.PricePerNight.ToString("N2") / night · @a.Property?.MaxGuests guests</p><p>@a.Property?.Description</p><div class="gallery small-gallery">@foreach(var im in a.Property?.Images??new List<PropertyImage>()){<img src="@im.ImagePath" alt="Property image"/>}</div></div><form asp-action="Review" method="post" class="review-form"><input type="hidden" name="id" value="@a.Id"/><label>Review notes</label><textarea name="notes" rows="3"></textarea><button class="btn" name="decision" value="Approved">Approve application</button><button class="btn danger" name="decision" value="Rejected">Reject application</button></form></article>}</div>@if(Model.Count==0){<div class="empty"><h3>You're all caught up</h3><p>No pending applications.</p></div>}
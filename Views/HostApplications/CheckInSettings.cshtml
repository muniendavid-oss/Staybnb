@model CheckInProcess
@{ViewData["Title"]="Check-in settings";var property=(Property)ViewBag.Property;}<div class="page-intro"><p class="eyebrow">GUEST ARRIVAL</p><h1>Check-in settings</h1><p>@property.Title · @property.City</p></div><form asp-action="CheckInSettings" method="post" class="panel form-card wide"><input asp-for="PropertyId" type="hidden"/><div asp-validation-summary="ModelOnly" class="error"></div><label asp-for="Instructions">Check-in instructions and rules</label><textarea asp-for="Instructions" rows="6" placeholder="Explain how guests access the property, arrival times, keys, house rules, and who to contact." required></textarea><span asp-validation-for="Instructions" class="field-error"></span><label asp-for="RequiredDocuments">Required documents</label><textarea asp-for="RequiredDocuments" rows="3" placeholder="e.g. Passport or ID document for every adult guest"></textarea><button class="btn">Save check-in instructions</button></form>
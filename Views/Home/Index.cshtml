@model List<Property>
@{ViewData["Title"]="Find your stay";}<section class="hero"><p class="eyebrow">STAY A LITTLE DIFFERENT</p><h1>Find a place that<br/><em>feels like yours.</em></h1><p>Thoughtful stays for weekends away, work trips, and everything in between.</p><form method="get" class="searchbar"><input name="city" value="@ViewBag.City" placeholder="Where to? Enter a city"/><select name="type"><option value="">All property types</option>@foreach(var t in new[]{"Apartment","House","Guesthouse","Villa","Cabin"}){<option selected="@(ViewBag.Type==t)" value="@t">@t</option>}</select><button class="btn">Search stays</button></form></section><div class="section-head"><div><p class="eyebrow">CURATED FOR YOU</p><h2>Places to stay</h2></div><span class="muted">@Model.Count stays found</span></div>@if(Model.Count==0){<div class="empty"><h3>No stays found just yet</h3><p>Try another city or check back soon as hosts add new places.</p></div>}<div class="grid">@foreach(var p in Model){<article class="property-card"><a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id" class="photo">@if(p.Images.FirstOrDefault(i=>i.IsPrimary) is PropertyImage img){<img src="@img.ImagePath" alt="@p.Title"/>}else{<div class="placeholder">staybnb.</div>}<span class="pill">@p.PropertyType</span></a><div class="card-content"><div class="card-title"><h3><a asp-controller="Properties" asp-action="Details" asp-route-id="@p.Id">@p.Title</a></h3><span>@p.City</span></div><p class="muted">@p.MaxGuests guests · @p.Address</p><p class="price">R @p.PricePerNight.ToString("N0") <small>/ night</small></p></div></article>}</div>
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - Staybnb</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body><header class="nav"><a class="brand" asp-controller="Home" asp-action="Index">staybnb<span>.</span></a><nav><a asp-controller="Home" asp-action="Index">Explore</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Communication" asp-action="Inbox">Inbox</a><a asp-controller="Communication" asp-action="Notifications">Notifications</a>@if(User.IsInRole("Guest")){<a asp-controller="HostApplications" asp-action="Apply">Become a host</a><a asp-controller="Bookings" asp-action="Mine">My trips</a>}@if(User.IsInRole("Host")){<a asp-controller="HostApplications" asp-action="Dashboard">Host dashboard</a><a asp-controller="Properties" asp-action="Manage">My listings</a>}@if(User.IsInRole("Admin")||User.IsInRole("SuperAdmin")){<a asp-controller="Admin" asp-action="Index">Admin</a>}<form asp-controller="Account" asp-action="Logout" method="post" class="inline"><button class="linkbutton">Log out</button></form>}else{<a asp-controller="Account" asp-action="Login">Log in</a><a class="nav-cta" asp-controller="Account" asp-action="Register">Sign up</a>}</nav></header><main class="container">@if(TempData["Message"]!=null){<div class="notice">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="error">@TempData["Error"]</div>}@RenderBody()</main><footer>Staybnb · Find your place, feel at home.</footer>@await RenderSectionAsync("Scripts",required:false)</body></html>
@model List<ActivityLog>
@{ViewData["Title"]="Activity logs";}<div class="page-intro"><h1>System activity log</h1><p>Latest 500 security and business events.</p></div><div class="table-wrap"><table><thead><tr><th>Time (UTC)</th><th>User ID</th><th>Action</th><th>Details</th><th>Entity</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td class="id-cell">@l.UserId</td><td>@l.Action</td><td>@l.Details</td><td>@l.EntityType @l.EntityId</td></tr>}</tbody></table></div>
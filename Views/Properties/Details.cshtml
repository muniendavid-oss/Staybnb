@model Property
@{ViewData["Title"]=Model.Title;}<a class="back" asp-controller="Home" asp-action="Index">← Back to stays</a><div class="detail-head"><div><p class="eyebrow">@Model.City · @Model.PropertyType</p><h1>@Model.Title</h1><p class="muted">@Model.Address · Up to @Model.MaxGuests guests</p></div><div class="price">R @Model.PricePerNight.ToString("N2") <small>/ night</small></div></div><div class="gallery">@foreach(var image in Model.Images){<img src="@image.ImagePath" alt="@Model.Title"/>}</div><div class="detail-layout"><section><h2>About this place</h2><p class="description">@Model.Description</p><hr/><h3>Hosted by @(Model.Host?.DisplayName ?? "Staybnb host")</h3><p class="muted">A local host, ready to help make your stay comfortable.</p></section><aside class="panel"><p class="price">R @Model.PricePerNight.ToString("N2") <small>/ night</small></p><p>Cleaning fee: R @Model.CleaningFee.ToString("N2")</p><p>Service fee: R @Model.ServiceFee.ToString("N2")</p>@if(User.IsInRole("Guest")){<a class="btn full" asp-controller="Bookings" asp-action="Create" asp-route-propertyId="@Model.Id">Reserve this stay</a>}else if(!User.Identity!.IsAuthenticated){<a class="btn full" asp-controller="Account" asp-action="Login">Log in to book</a>}else{<p class="muted">Booking is available to Guest accounts.</p>}</aside></div>
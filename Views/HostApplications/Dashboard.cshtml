@{ViewData["Title"]="Host dashboard";var props=(List<Property>)ViewBag.Properties;var bookings=(List<Booking>)ViewBag.Bookings;}<div class="page-intro"><p class="eyebrow">YOUR SPACE, YOUR BUSINESS</p><h1>Host dashboard</h1><p>Manage your listings and take care of upcoming guests.</p></div><div class="stats"><div class="stat"><span>Properties</span><strong>@props.Count</strong></div><div class="stat"><span>Pending requests</span><strong>@bookings.Count(b=>b.Status=="Pending")</strong></div><div class="stat"><span>Approved bookings</span><strong>@bookings.Count(b=>b.Status=="Approved")</strong></div></div><div class="section-head"><h2>Your properties</h2><a asp-controller="Properties" asp-action="Manage">Manage listings →</a> <a asp-action="GuestDocuments">Review guest documents →</a></div><div class="grid">@foreach(var p in props){<article class="property-card"><div class="photo">@if(p.Images.FirstOrDefault(i=>i.IsPrimary) is PropertyImage im){<img src="@im.ImagePath" alt="@p.Title"/>}</div><div class="card-content"><h3>@p.Title</h3><p class="muted">@p.City · @p.PropertyType</p><span class="status">@(p.IsActive?"Active":"Inactive")</span><p><a asp-action="CheckInSettings" asp-route-propertyId="@p.Id">Configure check-in →</a></p></div></article>}</div><div class="section-head"><h2>Booking requests</h2></div><div class="table-wrap"><table><thead><tr><th>Property / Guest</th><th>Dates</th><th>Travelers</th><th>Total</th><th>Status / Action</th></tr></thead><tbody>@foreach(var b in bookings){<tr><td><strong>@b.Property?.Title</strong><br/><span class="muted">@b.Guest?.DisplayName (@b.Guest?.Email)</span></td><td>@b.CheckIn.ToString("dd MMM yyyy") – @b.CheckOut.ToString("dd MMM yyyy")</td><td>@b.Travelers</td><td>R @b.TotalPrice.ToString("N2")</td><td><span class="status">@b.Status</span>@if(b.Status=="Pending"){<form asp-controller="Bookings" asp-action="UpdateStatus" method="post" class="actions"><input type="hidden" name="id" value="@b.Id"/><button class="btn small">Approve</button><button class="btn danger small" name="status" value="Rejected">Reject</button><input type="hidden" name="status" value="Approved"/></form>}</td></tr>}</tbody></table></div>
@model List<Booking>
@{ViewData["Title"]="My trips";}<div class="page-intro"><p class="eyebrow">YOUR TRAVEL PLANS</p><h1>My trips</h1></div>@if(Model.Count==0){<div class="empty"><h3>No bookings yet</h3><p>Your next adventure starts with a great stay.</p><a class="btn" asp-controller="Home" asp-action="Index">Explore stays</a></div>}<div class="stack">@foreach(var b in Model){<article class="panel booking-row"><div>@if(b.Property?.Images.FirstOrDefault(i=>i.IsPrimary) is PropertyImage im){<img class="thumb" src="@im.ImagePath" alt="@b.Property.Title"/>}</div><div class="grow"><h3>@b.Property?.Title</h3><p class="muted">@b.CheckIn.ToString("dd MMM yyyy") – @b.CheckOut.ToString("dd MMM yyyy") · @b.Travelers travelers</p><p>R @b.TotalPrice.ToString("N2")</p></div><div><span class="status">@b.Status</span>@if(b.Status=="Approved"){<p><a asp-action="CheckIn" asp-route-id="@b.Id">Check-in steps →</a></p>}</div></article>}</div>
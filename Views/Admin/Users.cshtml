@model List<ApplicationUser>
@{ViewData["Title"]="User management";var roleMap=(Dictionary<string,string>)ViewBag.RoleMap;}<div class="page-intro"><p class="eyebrow">SUPERADMIN ONLY</p><h1>User management</h1><p>Only eligible Guest accounts can be promoted to Admin. Host and SuperAdmin roles are not changed here.</p></div><div class="table-wrap"><table><thead><tr><th>User</th><th>Current role(s)</th><th>Action</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.DisplayName<br/><span class="muted">@u.Email</span></td><td>@roleMap.GetValueOrDefault(u.Id,"None")</td><td>@if(roleMap.GetValueOrDefault(u.Id,"").Split(", ").Contains("Guest")){<form asp-action="Promote" method="post"><input type="hidden" name="userId" value="@u.Id"/><button class="btn small">Promote to Admin</button></form>}else{<span class="muted">No action</span>}</td></tr>}</tbody></table></div>
@model LoginViewModel
@{ViewData["Title"]="Log in";}<div class="auth-wrap"><form asp-action="Login" method="post" class="panel form-card"><p class="eyebrow">GOOD TO HAVE YOU BACK</p><h1>Log in</h1><div asp-validation-summary="ModelOnly" class="error"></div><label asp-for="Email"></label><input asp-for="Email"/><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password"></label><input asp-for="Password"/><span asp-validation-for="Password" class="field-error"></span><label class="check"><input asp-for="RememberMe"/> Remember me</label><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"/><button class="btn full">Log in</button><p class="muted center">New to Staybnb? <a asp-action="Register">Create an account</a></p></form></div>
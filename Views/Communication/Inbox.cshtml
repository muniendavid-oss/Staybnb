@model List<Message>
@{ViewData["Title"]="Inbox";}<div class="page-intro"><p class="eyebrow">STAY CONNECTED</p><h1>Your inbox</h1><p>Messages are stored in the database. Unread incoming messages are marked read when you open this page.</p></div><form asp-action="Send" method="post" class="panel form-card wide"><h2>Send a message</h2><label>Recipient email</label><input name="recipientEmail" type="email" required/><label>Message</label><textarea name="body" rows="3" maxlength="2000" required></textarea><button class="btn">Send message</button></form><h2>Recent messages</h2><div class="stack">@foreach(var m in Model){<article class="panel message"><div class="message-meta"><strong>@(m.SenderId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value?"You":m.Sender?.DisplayName)</strong><span class="muted">@m.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</span></div><p>@m.Body</p><p class="muted">@(m.SenderId==User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value?"To: "+m.Recipient?.Email:"From: "+m.Sender?.Email) · @(m.IsRead?"Read":"Unread")</p></article>}</div>
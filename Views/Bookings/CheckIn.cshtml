@{ViewData["Title"]="Guest check-in";var b=(Booking)ViewBag.Booking;var docs=(List<GuestDocument>)ViewBag.Documents;var process=(CheckInProcess?)ViewBag.CheckInProcess;}<div class="page-intro"><p class="eyebrow">ARRIVAL PREPARATION</p><h1>Check-in for @b.Property?.Title</h1><p>Booking #@b.Id · @b.CheckIn.ToString("dd MMM yyyy")</p></div><div class="panel form-card wide"><h2>Property check-in instructions</h2>@if(process!=null){<p>@process.Instructions</p><p class="muted">Required documents: @process.RequiredDocuments</p>}else{<p class="muted">Your host has not added property-specific instructions yet. Contact your host through the inbox if needed.</p>}<hr/><h2>Step 1 · Upload your ID or passport</h2><p class="muted">Your document is stored outside the public web folder. Upload it for your host to verify.</p><form asp-action="UploadDocument" method="post" enctype="multipart/form-data"><input type="hidden" name="id" value="@b.Id"/><label>Document type</label><select name="documentType"><option>Passport</option><option>ID</option></select><label>Document file (PDF/JPG/PNG, max 5 MB)</label><input type="file" name="document" accept=".pdf,.jpg,.jpeg,.png" required/><button class="btn">Upload document</button></form><h3>Your documents</h3>@if(docs.Count==0){<p>No documents uploaded yet.</p>}else{<div class="table-wrap"><table><thead><tr><th>Uploaded</th><th>Type</th><th>Status</th></tr></thead><tbody>@foreach(var d in docs){<tr><td>@d.UploadedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@d.DocumentType</td><td>@d.Status</td></tr>}</tbody></table></div>}<hr/><h2>Step 2 · Complete check-in</h2><p>Check-in can be completed after the host verifies your document.</p><form asp-action="CompleteCheckIn" method="post"><input type="hidden" name="id" value="@b.Id"/><button class="btn">Mark as checked in</button></form></div>